---
import { getUi } from '../i18n/ui';
import type { Language } from '../i18n/config';
interface Props { language?: Language; }
const { language = 'en' } = Astro.props;
const labels = getUi(language).calculator;
---
<section class="task-calculator" aria-labelledby="calculator-title">
  <div class="section-label">{labels.label}</div>
  <h2 id="calculator-title">{labels.title}</h2>
  <p class="calculator-description">{labels.description}</p>

  <div class="calculator-grid">
    <label>
      <span>{labels.hourlyRate}</span>
      <input type="number" name="hourlyRate" value="75" min="0" step="5" inputmode="decimal" />
    </label>
    <label>
      <span>{labels.modelCost}</span>
      <input type="number" name="modelCost" value="0.40" min="0" step="0.05" inputmode="decimal" />
    </label>
    <label>
      <span>{labels.correction}</span>
      <input type="number" name="taskMinutes" value="20" min="0" step="1" inputmode="numeric" />
    </label>
    <label>
      <span>{labels.exploration}</span>
      <input type="number" name="expansionMinutes" value="35" min="0" step="5" inputmode="numeric" />
    </label>
  </div>

  <div class="calculator-results" aria-live="polite">
    <div><strong data-task-total>€25.40</strong><span>{labels.taskTotal}</span></div>
    <div><strong data-expansion-total>€43.75</strong><span>{labels.expansionTotal}</span></div>
  </div>
</section>

<script>
  const calculators = document.querySelectorAll<HTMLElement>('.task-calculator');

  for (const calculator of calculators) {
    const read = (name: string) => {
      const input = calculator.querySelector<HTMLInputElement>(`[name="${name}"]`);
      return Number.parseFloat(input?.value ?? '') || 0;
    };

    const update = () => {
      const hourlyRate = read('hourlyRate');
      const directCost = read('modelCost');
      const taskCost = directCost + (read('taskMinutes') / 60) * hourlyRate;
      const expansionCost = (read('expansionMinutes') / 60) * hourlyRate;
      const format = (value: number) => `€${value.toFixed(2)}`;

      const taskOutput = calculator.querySelector<HTMLElement>('[data-task-total]');
      const expansionOutput = calculator.querySelector<HTMLElement>('[data-expansion-total]');
      if (taskOutput) taskOutput.textContent = format(taskCost);
      if (expansionOutput) expansionOutput.textContent = format(expansionCost);
    };

    calculator.addEventListener('input', update);
    update();
  }
</script>

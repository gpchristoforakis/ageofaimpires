---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro';
import type { CustomComponentsMap, TinaRichTextContent } from '@tinacms/astro/types';
import ComparisonTable from '../ComparisonTable.astro';

interface ArticleData extends Record<string, unknown> {
  body: TinaRichTextContent;
}

interface Props {
  data: ArticleData;
}

const { data } = Astro.props;
const components: CustomComponentsMap = { ComparisonTable };
---
<div data-tina-field={tinaField(data, 'body')}>
  <TinaMarkdown content={data.body} components={components} />
</div>

---
interface Props {
  kind: 'vehicles' | 'specifications' | 'journey';
  headers: string[];
  rows: string[][];
  language?: import('../i18n/config').Language;
}
import { getUi } from '../i18n/ui';
const { kind, headers, rows, language = 'en' } = Astro.props;
const labels = getUi(language);
const label = labels.tableAria[kind];
const hintId = `${kind}-scroll-hint`;
---

<div class:list={['comparison-table', `comparison-table--${kind}`]}>
  <div class="comparison-table-hint" id={hintId} data-reading-ui>{labels.tableScroll} <span aria-hidden="true">→</span></div>
  <div class="comparison-table-scroll" role="region" aria-label={label} aria-describedby={hintId} tabindex="0">
    <table aria-label={label}>
      <thead><tr>{headers.map((header) => <th scope="col">{header}</th>)}</tr></thead>
      <tbody>
        {rows.map((row) => <tr>{row.map((cell, index) => index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}
      </tbody>
    </table>
  </div>
</div>

---
import RouteDiagram from '../components/RouteDiagram.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Age of AI Empires — The economics of getting things done with AI';
const description = 'A clear-eyed publication about AI, work, money, time, attention, and the hidden cost of getting to a useful result.';
---

<BaseLayout title={title} description={description}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <div class="eyebrow">A publication about AI and actual work</div>
        <h1>The cheaper AI gets, the more expensive the <em>detour</em> can become.</h1>
        <p class="hero-lead">Age of AI Empires looks past token prices to examine what AI-assisted work actually costs: time, attention, corrections, scope creep, and the occasional useful rabbit hole.</p>
        <div class="hero-actions">
          <a class="button button-dark" href="/articles/llm-task-cost-paradox/">Read the first argument</a>
          <a class="button button-quiet" href="/frameworks/">See the framework</a>
        </div>
      </div>
      <RouteDiagram />
    </div>
  </section>

  <section class="section" id="featured">
    <div class="wrap">
      <div class="section-head">
        <div><div class="section-label">Featured argument / 01</div><h2>What does it really cost to get something done with an LLM?</h2></div>
        <p>Token prices tell us what computation costs. They do not tell us what the work costs.</p>
      </div>
      <a class="feature-card" href="/articles/llm-task-cost-paradox/">
        <div class="feature-number">01</div>
        <div><h3>The LLM Task-Cost Paradox</h3><p>Why better AI can cost more per task. A plain-English examination of remediation leakage, expansion leakage, the completion boundary, and the difference between task cost and task value.</p></div>
        <div class="meta">Part I<br />12 min read</div>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><div><div class="section-label">The library</div><h2>Ideas you can use before the jargon arrives.</h2></div></div>
      <div class="card-grid">
        <a class="mini-card" href="/frameworks/"><div class="section-label">Frameworks</div><h3>Short models for long conversations.</h3><p>Five-minute versions of the ideas behind the essays, with definitions, equations, and diagrams.</p><span class="arrow">↗</span></a>
        <a class="mini-card" href="/notebook/"><div class="section-label">Notebook</div><h3>Where the argument is still being sharpened.</h3><p>Working notes, test protocols, open questions, and the uncomfortable bits left visible.</p><span class="arrow">↗</span></a>
        <a class="mini-card" href="/about/"><div class="section-label">About</div><h3>A small publication for a large transition.</h3><p>Built for people who want to understand AI without pretending every prompt is a revolution.</p><span class="arrow">↗</span></a>
      </div>
    </div>
  </section>

  <section class="thesis-band">
    <div class="wrap thesis-grid">
      <div class="section-label">The working thesis</div>
      <div><blockquote>AI changes the cost of thinking. It does not remove the cost of deciding what deserves to be done.</blockquote><cite>— Age of AI Empires</cite></div>
    </div>
  </section>
</BaseLayout>

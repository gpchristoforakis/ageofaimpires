---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { articleTranslationPaths } from '../../../../i18n/content';
import { localizedPath, type Language } from '../../../../i18n/config';
import { getUi } from '../../../../i18n/ui';
import '../../../../styles/cars-editorial.css';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry) => ({ params: { lang: entry.data.language, slug: entry.data.routeSlug }, props: { entry } }));
}
interface Props { entry: CollectionEntry<'articles'>; }
const { entry } = Astro.props;
const language = entry.data.language as Language;
const t = getUi(language);
const translations = await articleTranslationPaths(entry.data.translationKey);
const { Content } = await render(entry);
const isCars = entry.data.translationKey === 'cars-vs-llms';
const carsImageAlt = language === 'el'
  ? 'Μινιμαλιστική απεικόνιση ενός αυτοκινήτου που κατευθύνεται ευθεία προς την ολοκληρωμένη εργασία, ενώ ένα άλλο έχει κολλήσει σε έναν κυκλικό κόμβο λανθασμένων διαδρομών.'
  : 'Minimalist illustration of a car driving straight toward finished work while another is stuck in a roundabout of wrong turns.';
---
<BaseLayout title={entry.data.title} description={entry.data.description} language={language} translations={translations} current="articles" ogType="article" image={isCars ? '/og/cars-vs-llms-roundabout.png' : '/og/llm-task-cost-paradox.png'} imageAlt={isCars ? carsImageAlt : 'The LLM Task-Cost Paradox — why better AI can cost more per task'}>
  {isCars ? <div class="cars-reading wrap"><div class="reading-meta"><a href={localizedPath(language, 'articles')}>{t.articles}</a><span>{entry.data.kicker}</span><span>{entry.data.readTime}</span></div><article class="article-content cars-article" aria-label={entry.data.heading}><Content /></article>{language === 'en' && <nav class="next-reading" aria-label={t.continueReading}><p class="section-label">{t.next}</p><a href={localizedPath(language, 'articles/llm-task-cost-paradox')}>The LLM Task-Cost Paradox <span aria-hidden="true">→</span></a><p>What does it cost to turn an AI answer into completed work?</p></nav>}</div>
  : <><section class="page-intro"><div class="wrap intro-row"><div><div class="article-kicker">Go deeper / The LLM Task-Cost Paradox</div><h1>Why better AI can cost more <em>per task.</em></h1></div><div class="intro-aside"><p>{entry.data.intro}</p></div></div></section><section class="wrap content-layout"><article class="article-content"><Content /><div class="article-actions"><a class="button button-dark" href={localizedPath(language, 'frameworks')}>Read the 5-minute framework</a><a class="button button-quiet" href={localizedPath(language, 'notebook')}>See the working notes</a></div></article><aside class="article-aside"><div><h2 class="aside-title">Filed under</h2><p>AI economics<br />Human-computer work<br />Responsible use</p></div><div><h2 class="aside-title">Start with the comparison</h2><p>Cars vs LLMs introduces a practical way to choose an AI for the job. This follow-up looks at the cost of getting the work finished.</p><a href={localizedPath(language, 'articles/choosing-ai-like-a-car')}>Read Cars vs LLMs →</a><a href={localizedPath(language, 'articles')}>{t.allArticles} →</a></div></aside></section></>}
</BaseLayout>

---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { defaultLanguage, type Language, type TranslationPaths } from '../i18n/config';
import { getUi } from '../i18n/ui';
import '../styles/global.css';
interface Props { title: string; description: string; language: Language; translations: TranslationPaths; current?: 'articles' | 'frameworks' | 'notebook' | 'about'; image?: string; imageAlt?: string; ogType?: 'website' | 'article'; noindex?: boolean; }
const { title, description, language, translations, current, image = '/og/default.png', imageAlt = 'Age of AI Empires publication card', ogType = 'website', noindex = false } = Astro.props;
const t = getUi(language);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const defaultPath = translations[defaultLanguage];
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="generator" content={Astro.generator} />
    <title>{title}</title><meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    {Object.entries(translations).map(([lang, path]) => <link rel="alternate" hreflang={lang} href={new URL(path, Astro.site)} />)}
    {defaultPath && <link rel="alternate" hreflang="x-default" href={new URL(defaultPath, Astro.site)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:locale" content={language === 'el' ? 'el_GR' : 'en_US'} /><meta property="og:type" content={ogType} /><meta property="og:site_name" content="Age of AI Empires" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonicalUrl} /><meta property="og:image" content={socialImage} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:type" content="image/png" /><meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={socialImage} /><meta name="twitter:image:alt" content={imageAlt} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t.skip}</a><SiteHeader language={language} current={current} translations={translations} /><main id="main-content" tabindex="-1"><slot /></main><SiteFooter language={language} />
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]'); const nav = document.querySelector<HTMLElement>('[data-site-nav]');
      if (toggle && nav) { const firstLink = nav.querySelector<HTMLAnchorElement>('a'); const setMenuState = (isOpen: boolean, restoreFocus = false) => { nav.classList.toggle('is-open', isOpen); toggle.setAttribute('aria-expanded', String(isOpen)); toggle.textContent = isOpen ? nav.dataset.closeLabel ?? 'Close' : nav.dataset.menuLabel ?? 'Menu'; if (isOpen) firstLink?.focus(); else if (restoreFocus) toggle.focus(); }; toggle.addEventListener('click', () => { const isOpen = toggle.getAttribute('aria-expanded') !== 'true'; setMenuState(isOpen, !isOpen); }); nav.addEventListener('click', (event) => { if (event.target instanceof HTMLAnchorElement) setMenuState(false, true); }); document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') setMenuState(false, true); }); }
    </script>
    <button id="floating-share-btn" aria-label={t.share} data-share-label={t.share} data-copied-label={t.copied} data-copy-prompt={t.copyLink}><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg><span>{t.share}</span></button>
    <script is:inline>
      const btn = document.getElementById('floating-share-btn');
      if (btn) btn.addEventListener('click', async () => {
        const canonicalHref = document.querySelector('link[rel="canonical"]')?.href;
        const shareUrl = new URL(canonicalHref || window.location.href);
        shareUrl.search = '';
        shareUrl.hash = '';

        try {
          await navigator.clipboard.writeText(shareUrl.href);
          const label = btn.querySelector('span');
          if (label) {
            label.textContent = btn.dataset.copiedLabel;
            btn.classList.add('is-copied');
            setTimeout(() => {
              label.textContent = btn.dataset.shareLabel;
              btn.classList.remove('is-copied');
            }, 2000);
          }
        } catch {
          prompt(btn.dataset.copyPrompt, shareUrl.href);
        }
      });
    </script>
  </body>
</html>

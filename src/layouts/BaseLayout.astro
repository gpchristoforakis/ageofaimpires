---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  current?: 'articles' | 'frameworks' | 'notebook' | 'about';
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  canonical?: boolean;
}

const {
  title,
  description,
  current,
  image = '/og/default.png',
  imageAlt = 'Age of AI Empires publication card',
  ogType = 'website',
  noindex = false,
  canonical: includeCanonical = true,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {includeCanonical && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Age of AI Empires" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {includeCanonical && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader current={current} />
    <main id="main-content" tabindex="-1"><slot /></main>
    <SiteFooter />
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const nav = document.querySelector<HTMLElement>('[data-site-nav]');

      if (toggle && nav) {
        const firstLink = nav.querySelector<HTMLAnchorElement>('a');

        const setMenuState = (isOpen: boolean, restoreFocus = false) => {
          nav.classList.toggle('is-open', isOpen);
          toggle.setAttribute('aria-expanded', String(isOpen));
          toggle.textContent = isOpen ? 'Close' : 'Menu';

          if (isOpen) firstLink?.focus();
          else if (restoreFocus) toggle.focus();
        };

        toggle.addEventListener('click', () => {
          const isOpen = toggle.getAttribute('aria-expanded') !== 'true';
          setMenuState(isOpen, !isOpen);
        });

        nav.addEventListener('click', (event) => {
          if (event.target instanceof HTMLAnchorElement) {
            setMenuState(false, true);
          }
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
            setMenuState(false, true);
          }
        });
      }
    </script>
<!-- Floating Share Button -->
<button
<script>
  const btn = document.getElementById('floating-share-btn');
  if (btn) {
    btn.addEventListener('click', async () => {
      const pageTitle = document.title || 'Age of AI Empires';
      const pageDescription = document.querySelector('meta[name="description"]')?.getAttribute('content') || '';
      const shareUrl = window.location.href;

      const formattedShareText = `${pageTitle}\n\n${pageDescription}\n\n${shareUrl}`;

      const shareData = {
        title: pageTitle,
        text: pageDescription,
        url: shareUrl,
      };

      if (navigator.share) {
        try {
          await navigator.share(shareData);
        } catch (err) {
          // User closed share dialog
        }
      } else {
        try {
          await navigator.clipboard.writeText(formattedShareText);
          const label = btn.querySelector('span');
          if (label) {
            const originalText = label.textContent;
            label.textContent = 'Copied!';
            setTimeout(() => { label.textContent = originalText; }, 2000);
          }
        } catch (e) {
          prompt('Copy link:', formattedShareText);
        }
      }
    });
  }
</script>
  </body>
</html>

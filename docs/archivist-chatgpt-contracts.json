{
  "contractVersion": "0.2.0",
  "status": "implemented_prototype",
  "inspectedMain": "a0726fe9c1b73b5667b1d605daf00bfb19c2a313",
  "schemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "notes": [
    "Each inputSchema and outputSchema is self-contained; local $refs resolve within that schema.",
    "JSON Schema does not enforce registry membership, grounding support, whitespace trimming, redirects or source-text fidelity. Those require application checks.",
    "MCP content must include a text representation and explicit canonical Markdown links alongside successful structuredContent.",
    "Error content uses errorContentSchema with isError=true; do not report provider failure as no_supported_sources.",
    "Curated reading paths use selection_origin=curated and content_origin=live_site; Gemini File Search results retain content_origin=file_search.",
    "These contracts are used by the local MCP prototype. They are not an installed ChatGPT plugin or a production release."
  ],
  "tools": [
    {
      "name": "query_archive",
      "title": "Query The Archive",
      "description": "Find answers and reading in the published AGE OF AIMPIRES archive. Ask about an idea, look for something relevant to read, or find a starting point if you're new to AI assistants. Some recommendations are checked against current published pages; other answers use the archive search. The Archivist links to its sources and says when the archive cannot support an answer. It cannot search the wider web or private material.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "A self-contained archive question. Trim and reject whitespace-only values."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "$defs": {
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "url",
              "page_type",
              "publication_date"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "url": {
                "type": "string",
                "format": "uri",
                "maxLength": 2048,
                "pattern": "^https://ageofaimpires\\.com/[a-z0-9-]+$"
              },
              "page_type": {
                "type": "string",
                "enum": [
                  "entry",
                  "framework",
                  "how_to",
                  "notebook",
                  "about"
                ]
              },
              "publication_date": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "content_origin",
              "answer",
              "sources"
            ],
            "properties": {
              "status": {
                "const": "grounded"
              },
              "content_origin": {
                "const": "file_search"
              },
              "answer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60000
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "$ref": "#/$defs/source"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "content_origin",
              "answer",
              "sources"
            ],
            "properties": {
              "status": {
                "const": "no_supported_sources"
              },
              "content_origin": {
                "const": "file_search"
              },
              "answer": {
                "const": "The available archive did not provide verifiable support for an answer to this question."
              },
              "sources": {
                "type": "array",
                "maxItems": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "content_origin",
              "selection_origin",
              "answer",
              "sources"
            ],
            "properties": {
              "status": {
                "const": "grounded"
              },
              "content_origin": {
                "const": "live_site"
              },
              "selection_origin": {
                "const": "curated"
              },
              "answer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60000
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "$ref": "#/$defs/source"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "content_origin",
              "selection_origin",
              "answer",
              "sources"
            ],
            "properties": {
              "status": {
                "const": "no_supported_sources"
              },
              "content_origin": {
                "const": "live_site"
              },
              "selection_origin": {
                "const": "curated"
              },
              "answer": {
                "const": "The available archive did not provide verifiable support for an answer to this question."
              },
              "sources": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": true
      },
      "securitySchemes": [
        {
          "type": "noauth"
        }
      ]
    },
    {
      "name": "fetch_entry",
      "title": "Fetch A Published Page",
      "description": "Read the current published text of an AGE OF AIMPIRES Entry, Guide, Framework, Notebook or About page. Explore a recommended reading, examine the original wording or verify an exact quotation. This tool cannot access drafts, private documents or unrelated websites.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Exact public slug from a returned source. Must match an eligible server registry record."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "content_origin",
          "source",
          "text",
          "sections"
        ],
        "properties": {
          "status": {
            "const": "ok"
          },
          "content_origin": {
            "const": "live_site"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60000
          },
          "sections": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading",
                "anchor"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "anchor": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        },
        "$defs": {
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "url",
              "page_type",
              "publication_date"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "url": {
                "type": "string",
                "format": "uri",
                "maxLength": 2048,
                "pattern": "^https://ageofaimpires\\.com/[a-z0-9-]+$"
              },
              "page_type": {
                "type": "string",
                "enum": [
                  "entry",
                  "framework",
                  "how_to",
                  "notebook",
                  "about"
                ]
              },
              "publication_date": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": true
      },
      "securitySchemes": [
        {
          "type": "noauth"
        }
      ]
    }
  ],
  "errorContentSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "code",
      "message",
      "retryable"
    ],
    "properties": {
      "code": {
        "type": "string",
        "enum": [
          "invalid_arguments",
          "archive_unavailable",
          "archive_timeout",
          "rate_limited",
          "entry_not_found",
          "entry_unavailable",
          "entry_identity_mismatch",
          "entry_too_large"
        ]
      },
      "message": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "retryable": {
        "type": "boolean"
      }
    }
  },
  "examples": {
